{
  "name": "@zwave-js/config",
  "version": "15.31.1",
  "description": "zwave-js: configuration files",
  "keywords": [],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "@@dev": "./src/index.ts",
      "import": "./build/esm/index.js",
      "require": "./build/cjs/index.js"
    },
    "./safe": {
      "@@dev": "./src/index_safe.ts",
      "import": "./build/esm/index_safe.js",
      "require": "./build/cjs/index_safe.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#default_bindings/fs": {
      "@@dev": "@zwave-js/core/bindings/fs/node",
      "node": "@zwave-js/core/bindings/fs/node",
      "default": "@zwave-js/core/bindings/fs/stub"
    },
    "#default_bindings/log": {
      "@@dev": "@zwave-js/core/bindings/log/node",
      "node": "@zwave-js/core/bindings/log/node",
      "default": "@zwave-js/core/bindings/log/stub"
    },
    "#config_dir": {
      "@@dev": "./src/configDir.node.ts",
      "browser": "./build/esm/configDir.browser.js",
      "import": "./build/esm/configDir.node.js",
      "require": "./build/cjs/configDir.node.js"
    }
  },
  "files": [
    "build/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts,map}",
    "build/**/package.json",
    "config/"
  ],
  "sideEffects": false,
  "author": {
    "name": "AlCalzone",
    "email": "d.griesel@gmx.net"
  },
  "license": "MIT",
  "homepage": "https://github.com/zwave-js/zwave-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zwave-js/zwave-js.git"
  },
  "bugs": {
    "url": "https://github.com/zwave-js/zwave-js/issues"
  },
  "funding": {
    "url": "https://github.com/sponsors/AlCalzone/"
  },
  "engines": {
    "node": ">= 20"
  },
  "scripts": {
    "ts": "tsx --conditions=@@dev",
    "codegen": "yarn ts maintenance/codegen.ts",
    "build": "tsgo -b tsconfig.build.json --pretty && yarn postbuild",
    "postbuild": "yarn esm2cjs --in build/esm --out build/cjs -l error -t node20",
    "clean": "del-cli build/ \"*.tsbuildinfo\"",
    "extract-api": "yarn api-extractor run",
    "lint:zwave": "yarn lint:config:custom && yarn lint:config:eslint",
    "lint:config:custom": "yarn ts maintenance/lintConfigFiles.ts",
    "lint:config:eslint": "eslint --cache --cache-location .eslintcache/config -c config/eslint.config.mjs",
    "lint:ts": "eslint --cache --cache-location .eslintcache/ts \"src/**/*.ts\"",
    "lint:ts:fix": "yarn run lint:ts --fix",
    "test:ts": "vitest",
    "test:dirty": "tsx ../maintenance/src/resolveDirtyTests.ts --run"
  },
  "dependencies": {
    "@zwave-js/core": "workspace:*",
    "@zwave-js/shared": "workspace:*",
    "alcalzone-shared": "^5.0.0",
    "ansi-colors": "^4.1.3",
    "eslint": "^10.3.0",
    "json-logic-js": "^2.0.5",
    "json5": "^2.2.3",
    "pathe": "^2.0.3",
    "semver": "^7.8.5",
    "tslib": "^2.8.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@alcalzone/esm2cjs": "^1.4.2",
    "@microsoft/api-extractor": "^7.58.7",
    "@types/js-levenshtein": "^1.1.3",
    "@types/json-logic-js": "^2.0.8",
    "@types/node": "^20.19.35",
    "@types/semver": "^7.7.1",
    "@types/sinon": "^21.0.0",
    "@types/xml2js": "^0.4.14",
    "@types/yargs": "^17.0.35",
    "@typescript/native-preview": "7.0.0-dev.20260423.1",
    "@zwave-js/maintenance": "workspace:*",
    "comment-json": "^4.6.2",
    "del-cli": "^7.0.0",
    "es-main": "^1.4.0",
    "js-levenshtein": "^1.1.6",
    "ky": "^1.14.3",
    "sinon": "^22.0.0",
    "tsx": "^4.23.1",
    "vitest": "~4.0.18",
    "xml2js": "^0.6.2",
    "yargs": "^18.0.0"
  }
}
